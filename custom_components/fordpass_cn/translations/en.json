{
  "config": {
    "step": {
      "user": {
        "title": "Choose Brand",
        "description": "Choose the brand to connect: {brands}.\n\n- FordPass: fully supported (SMS code / password login, all features)\n- Lincoln Way: fully supported (SMS code login, shares the same cloud encryption system as FordPass)",
        "data": {
          "brand": "Brand"
        },
        "data_description": {}
      },
      "phone": {
        "title": "Phone Number Login",
        "description": "Enter the registered phone number to receive an SMS code.",
        "data": {
          "phone": "Phone number"
        },
        "data_description": {}
      },
      "code": {
        "title": "Enter Verification Code",
        "description": "The code has been sent to {phone}. Enter the 6-digit code.",
        "data": {
          "passcode": "SMS verification code"
        },
        "data_description": {}
      },
      "password": {
        "title": "Username & Password Login",
        "description": "Enter the account and password. The password is stored only in the local Home Assistant configuration. Next, open the login link in a browser and paste the authorization code.",
        "data": {
          "username": "Username (phone number)",
          "password": "Password"
        },
        "data_description": {}
      },
      "b2c": {
        "title": "Paste Authorization Code",
        "description": "The official Ford login page is protected by additional sign-in verification, so the integration cannot submit the password directly. Please complete the login in a browser and copy the authorization code:\n\n1. Open the login link below in your computer or phone browser and sign in with your FordPass account (username: {username});\n2. After login the browser redirects to ford.com.cn with ?code=... in the address bar. Copy that code and paste it here;\n3. The code is single-use and expires right after the token exchange.\n\nIf the browser asks for verification or the page is unavailable, retry later or use SMS code login instead.\n\nLogin link:\n{login_url}",
        "data": {
          "code": "Authorization code"
        },
        "data_description": {}
      },
      "reauth_confirm": {
        "title": "Re-authenticate",
        "description": "Your credentials have expired. Re-authenticate to continue (the integration and entities will not be removed)."
      },
      "login_mode": {
        "title": "Choose Login Method",
        "description": "Choose a login method: {login_modes}.",
        "data": {
          "login_mode": "Login method"
        },
        "data_description": {}
      }
    },
    "error": {
      "bad_phone": "Please enter a valid 11-digit phone number",
      "bad_username": "Please enter a valid 11-digit phone number (username)",
      "passcode_failed": "Failed to send the verification code. Check that the phone number is registered with FordPass China, or retry later (see log)",
      "missing_deps": "Missing dependency packages. Confirm they were installed automatically when the integration installed, or retry later (see log)",
      "login_failed": "Login failed. Check that the verification code is correct (see log)",
      "unknown": "Unknown error. Check the fordpass_cn entries in the Home Assistant log",
      "bad_code": "Invalid or expired authorization code. Please log in again in the browser and copy a fresh code.",
      "crypto_data_missing": "The runtime data pack is missing, so login cannot proceed. Allow the integration to fetch it online, or place the data pack manually as described in the notification and retry."
    },
    "abort": {
      "already_configured": "This phone number is already configured for this brand",
      "reauth_phone_mismatch": "The logged-in account differs from the original phone number. Please remove and reconfigure the integration.",
